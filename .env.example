# Copia a .env (ignorado) solo para desarrollo. En producción van en Variables de Railway.
PORT=3000
# Postgres de Railway (Railway la inyecta sola al conectar la base). Vacía = memoria.
DATABASE_URL=
# Token largo y aleatorio: el MCP vive en /mcp/<MCP_TOKEN>. Vacío = MCP apagado.
MCP_TOKEN=
# URL pública de la landing (la usa la herramienta estado_campana).
URL_PUBLICA=
