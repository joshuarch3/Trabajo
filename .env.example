# Copia a .env (ignorado) solo para desarrollo. Nunca subas claves al repo.
PORT=3000
# Postgres opcional. Vacía = memoria.
DATABASE_URL=
# Token largo y aleatorio (mín. 24 caracteres): el MCP vive en /mcp/<MCP_TOKEN>. Vacío = MCP apagado.
MCP_TOKEN=
# URL pública de la landing (la usa la herramienta estado_campana).
URL_PUBLICA=
